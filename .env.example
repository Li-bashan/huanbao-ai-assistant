VITE_DIFY_USER=your-user-id
VITE_USE_DIFY=true

VITE_POLICY_DIFY_API_BASE=http://your-dify-host/v1
VITE_POLICY_DIFY_API_KEY=app-your-policy-key

VITE_OFFICE_DIFY_API_BASE=http://your-dify-host/v1
VITE_OFFICE_DIFY_API_KEY=app-your-office-key

# 智能问数使用 Dify Chat API（/chat-messages）
VITE_DATA_QUERY_DIFY_API_BASE=http://your-dify-host/v1
VITE_DATA_QUERY_DIFY_API_KEY=app-your-data-query-key
# 可按后端实际可查询期间配置，例如：今年、2025年
VITE_DATA_QUERY_DEFAULT_PERIOD=今年

# 智能问数开放范围检查与人员管理 API；留空时使用当前站点相对路径
VITE_AI_GATEWAY_BASE_URL=http://localhost:8088

# 跨域 iframe 时用于 postMessage 用户信息握手；留空时优先使用 document.referrer
VITE_IGIX_PORTAL_ORIGIN=http://172.17.3.34:5300
